{
    "functions": {
        "server/_core/index.ts": {
            "runtime": "@vercel/node"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server/_core/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}