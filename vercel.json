{
    "version": 2,
    "functions": {
        "api/main.js": {
            "includeFiles": "dist/public/**",
            "runtime": "nodejs20.x"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/main.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}